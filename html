<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Raul Coder Studio | TechroLim Factory Forge</title>
    <style>
        :root {
            --bg-base: #06080c;
            --panel-bg: #0f131c;
            --accent-cyan: #00ffcc;
            --accent-glow: rgba(0, 255, 204, 0.25);
            --text-main: #e2e8f0;
            --text-dim: #718096;
            --border-color: #1a2332;
            --editor-bg: #030406;
            --chat-user: #172033;
            --chat-raul: #0b111d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: monospace, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            height: 100vh;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Top Header & Auto-Config Bar */
        header {
            background-color: var(--panel-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            background-color: var(--accent-cyan);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent-cyan);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 0.4; }
            50% { opacity: 1; }
            100% { opacity: 0.4; }
        }

        h1 {
            font-size: 14px;
            letter-spacing: 1px;
            color: var(--accent-cyan);
            text-transform: uppercase;
        }

        .subtitle {
            font-size: 9px;
            color: var(--text-dim);
        }

        .header-actions {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        button {
            background: var(--border-color);
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 11px;
            cursor: pointer;
            text-transform: uppercase;
            font-weight: bold;
            transition: all 0.2s;
        }

        button:active {
            background: var(--accent-cyan);
            color: var(--bg-base);
        }

        .btn-run {
            background: var(--accent-cyan) !important;
            color: var(--bg-base) !important;
        }

        /* Port Config Dropdown Drawer */
        .config-bar {
            background: #090d14;
            border-bottom: 1px solid var(--border-color);
            padding: 6px 14px;
            font-size: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-dim);
        }

        .config-bar input {
            background: var(--editor-bg);
            border: 1px solid var(--border-color);
            color: var(--accent-cyan);
            padding: 3px 6px;
            border-radius: 3px;
            width: 60px;
            text-align: center;
            font-family: monospace;
            font-size: 10px;
        }

        /* Main Workspace Layout */
        .workspace {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        @media (min-width: 768px) {
            .workspace {
                flex-direction: row;
            }
        }

        /* Editor Section */
        .editor-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--editor-bg);
            border-bottom: 1px solid var(--border-color);
        }

        @media (min-width: 768px) {
            .editor-pane {
                border-bottom: none;
                border-right: 1px solid var(--border-color);
            }
        }

        .pane-header {
            background: var(--panel-bg);
            padding: 8px 12px;
            font-size: 10px;
            color: var(--text-dim);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-transform: uppercase;
        }

        textarea.code-editor {
            flex: 1;
            background: var(--editor-bg);
            color: var(--accent-cyan);
            border: none;
            padding: 12px;
            font-size: 13px;
            line-height: 1.5;
            resize: none;
            outline: none;
            tab-size: 4;
            font-family: monospace;
        }

        .console-output {
            height: 110px;
            background: #020305;
            border-top: 1px solid var(--border-color);
            padding: 8px 12px;
            font-size: 11px;
            color: #a0aec0;
            overflow-y: auto;
            font-family: monospace;
        }

        .console-output div {
            margin-bottom: 3px;
        }

        .console-output .error { color: #fc8181; }
        .console-output .success { color: #68d391; }
        .console-output .info { color: #63b3ed; }

        /* AI Chat & Agent Section */
        .chat-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg-base);
            max-height: 50vh;
        }

        @media (min-width: 768px) {
            .chat-pane {
                max-height: none;
            }
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message {
            max-width: 92%;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 12px;
            line-height: 1.4;
            word-break: break-word;
            border: 1px solid var(--border-color);
        }

        .message.user {
            background-color: var(--chat-user);
            align-self: flex-end;
            border-color: #2a3b58;
        }

        .message.raul {
            background-color: var(--chat-raul);
            align-self: flex-start;
            border-left: 3px solid var(--accent-cyan);
        }

        .sender {
            font-size: 9px;
            color: var(--text-dim);
            margin-bottom: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-panel {
            background-color: var(--panel-bg);
            border-top: 1px solid var(--border-color);
            padding: 10px 12px;
            display: flex;
            gap: 8px;
        }

        textarea.chat-input {
            flex: 1;
            background-color: var(--bg-base);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 10px;
            border-radius: 4px;
            font-size: 13px;
            resize: none;
            height: 38px;
            outline: none;
        }

        textarea.chat-input:focus {
            border-color: var(--accent-cyan);
        }

        .footer-bar {
            background: #040507;
            padding: 4px 12px;
            font-size: 9px;
            color: var(--text-dim);
            display: flex;
            justify-content: space-between;
            border-top: 1px solid #0f172a;
        }
    </style>
</head>
<body>

    <!-- Header & Brand Bar -->
    <header>
        <div class="brand-box">
            <div class="status-dot" id="sysStatus"></div>
            <div>
                <h1>Raul Coder Studio</h1>
                <div class="subtitle">TechroLim Factory Forge | Native APK Ready</div>
            </div>
        </div>
        <div class="header-actions">
            <button onclick="injectCode()">Inject</button>
            <button class="btn-run" onclick="runCode()">▶ Run</button>
            <button onclick="exportApp()">Export</button>
        </div>
    </header>

    <!-- Auto-Configured Port Bar -->
    <div class="config-bar">
        <span>Auto-Bus: <strong id="activeBusLabel" style="color:var(--accent-cyan);">ws://localhost:8888</strong></span>
        <div style="display:flex; align-items:center; gap:6px;">
            <span>Port:</span>
            <input type="number" id="portInput" value="8888" onchange="updatePort(this.value)">
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="workspace">
        <!-- Editor Pane -->
        <div class="editor-pane">
            <div class="pane-header">
                <span>Active Code Stack (Gunk / JS)</span>
                <span id="execState" style="color:var(--accent-cyan);">Ready</span>
            </div>
            <textarea id="codeEditor" class="code-editor" spellcheck="false">// Raul Coder [AI Architect & Code Engine]
// Automatically pre-configured & ready to execute.
function initializeStudio() {
    console.log("Initializing Factory Forge Megaplex Studio...");
    const config = { brand: "TechroLim", port: 8888, mode: "Standalone PWA/APK" };
    console.table(config);
    return "Raul Coder Engine operational.";
}
initializeStudio();</textarea>
            <div class="console-output" id="consoleOutput">
                <div class="success">> Raul Coder Engine auto-started on port 8888. Sandbox ready.</div>
            </div>
        </div>

        <!-- Chat & Agent Pane -->
        <div class="chat-pane">
            <div class="pane-header">
                <span>AI Agent Raul [Core Architect]</span>
                <span style="color:var(--accent-cyan);">Active Roster</span>
            </div>
            <div class="chat-container" id="chatContainer">
                <div class="message raul">
                    <div class="sender">Raul Coder</div>
                    Yo James! Raul Coder online and fully operational. Everything is auto-configured out of the box on port 8888 with zero setup friction. Tell me what code, Gunk function, or audio module you want to forge, and I'll write and inject it right into your editor!
                </div>
            </div>
            <div class="input-panel">
                <textarea id="userInput" class="chat-input" placeholder="Ask Raul to write or build code..." rows="1" onkeydown="handleKey(event)"></textarea>
                <button class="btn-run" onclick="sendMessage()" style="padding:0 16px; border-radius:4px;">Send</button>
            </div>
        </div>
    </div>

    <div class="footer-bar">
        <span>Framework: TechroLim Single-File Architecture</span>
        <span>Environment: Mobile Workstation</span>
    </div>

    <script>
        const chatContainer = document.getElementById('chatContainer');
        const userInput = document.getElementById('userInput');
        const codeEditor = document.getElementById('codeEditor');
        const consoleOutput = document.getElementById('consoleOutput');
        const execState = document.getElementById('execState');
        const portInput = document.getElementById('portInput');
        const activeBusLabel = document.getElementById('activeBusLabel');

        let currentPort = '8888';
        let lastInjectedCode = '';

        // Auto-configure port on load
        function updatePort(val) {
            currentPort = val || '8888';
            activeBusLabel.textContent = `ws://localhost:${currentPort}`;
            logMessage(`Port reconfigured to ${currentPort}. WebSocket bus target updated.`, 'info');
        }

        function logMessage(msg, type = 'normal') {
            const div = document.createElement('div');
            div.className = type;
            div.textContent = `> ${msg}`;
            consoleOutput.appendChild(div);
            consoleOutput.scrollTop = consoleOutput.scrollHeight;
        }

        // Intercept console output for real execution
        const origLog = console.log;
        const origTable = console.table;

        console.log = function(...args) {
            origLog.apply(console, args);
            logMessage(args.map(a => typeof a === 'object' ? JSON.stringify(a) : a).join(' '), 'normal');
        };

        console.table = function(data) {
            origTable.apply(console, [data]);
            logMessage(JSON.stringify(data, null, 2), 'success');
        };

        function runCode() {
            consoleOutput.innerHTML = '';
            execState.textContent = 'Executing...';
            execState.style.color = '#f6e05e';

            try {
                const result = new Function(codeEditor.value)();
                if (result !== undefined) {
                    logMessage(`Return: ${result}`, 'success');
                }
                execState.textContent = 'Success';
                execState.style.color = '#68d391';
            } catch (err) {
                logMessage(`Error: ${err.message}`, 'error');
                execState.textContent = 'Error';
                execState.style.color = '#fc8181';
            }
        }

        function appendChat(sender, text, isRaul = false) {
            const div = document.createElement('div');
            div.className = `message ${isRaul ? 'raul' : 'user'}`;
            
            const head = document.createElement('div');
            head.className = 'sender';
            head.textContent = sender;
            div.appendChild(head);

            const body = document.createElement('div');
            body.innerHTML = escapeHtml(text).replace(/\n/g, '<br>');
            div.appendChild(body);

            chatContainer.appendChild(div);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function sendMessage() {
            const text = userInput.value.trim();
            if (!text) return;

            appendChat('James Fetherolf', text, false);
            userInput.value = '';
            userInput.style.height = '38px';

            setTimeout(() => {
                const response = generateRaulResponse(text);
                appendChat('Raul Coder', response.text, true);
                if (response.code) {
                    lastInjectedCode = response.code;
                    logMessage("Raul generated new code. Click 'Inject' to load into workspace.", 'info');
                }
            }, 400);
        }

        function generateRaulResponse(query) {
            const q = query.toLowerCase();
            if (q.includes('synth') || q.includes('audio') || q.includes('bass') || q.includes('sound')) {
                const code = `// TechroLim Audio DSP Module (Generated by Raul Coder)
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playGunkBass() {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(48, audioCtx.currentTime); // Deep Bass
    gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.2);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 1.2);
    console.log("Dark Alley Gunk Bass triggered on port " + ${currentPort});
}
playGunkBass();`;
                return {
                    text: "Got it, James. Drafted a low-end Gunk bass audio module for our studio stack. Click 'Inject' to load it into the editor.",
                    code: code
                };
            } else if (q.includes('websocket') || q.includes('bus') || q.includes('connect')) {
                const code = `// Factory Forge Bus Connector (Port ${currentPort})
const bus = new WebSocket('ws://localhost:' + ${currentPort});
bus.onopen = () => console.log("Connected successfully to port " + ${currentPort});
bus.onmessage = (e) => console.log("Bus Event:", e.data);`;
                return {
                    text: `Wired up the WebSocket connector for port ${currentPort}. Ready for live event streaming.`,
                    code: code
                };
            } else {
                const code = `// Custom Workflow: ${query}
console.log("Executing module for: ${query}");
const metrics = { status: "ONLINE", port: ${currentPort}, timestamp: new Date().toLocaleTimeString() };
console.table(metrics);`;
                return {
                    text: `Locked in, James. I've structured the execution script for "${query}". Hit 'Inject' to load it right into your workspace.`,
                    code: code
                };
            }
        }

        function injectCode() {
            if (lastInjectedCode) {
                codeEditor.value = lastInjectedCode;
                logMessage("Injected Raul's generated script into the active code editor.", 'success');
            } else {
                logMessage("No pending code to inject. Ask Raul to build something specific first!", 'error');
            }
        }

        function handleKey(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        }

        function exportApp() {
            const html = document.documentElement.outerHTML;
            const blob = new Blob([html], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'raul_coder_studio.html';
            a.click();
            URL.revokeObjectURL(url);
        }

        userInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight > 100 ? 100 : this.scrollHeight) + 'px';
        });
    </script>
</body>
</html>
