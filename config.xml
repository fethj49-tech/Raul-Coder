<?xml version='1.0' encoding='utf-8'?>
<widget id="com.techrolim.raulcoder" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>RaulCoder</name>
    <description>Standalone Web Application</description>
    <author email="fethj49@gmail.com">TechroLim</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="ScrollEnabled" value="true" />
    <preference name="BackupWebStorage" value="none" />
</widget>
