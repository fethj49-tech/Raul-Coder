<?xml version='1.0' encoding='utf-8'?>
<widget id="com.techrolim.raulcoder" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Raul Coder</name>
    <description>Standalone IDE &amp; Code Agent Studio for Factory Forge Megaplex</description>
    <author email="fethj49@gmail.com" href="https://github.com/fethj49-tech">James Fetherolf (TechroLim)</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="AndroidPersistentStorage" value="Local" />
    <engine name="android" spec="^12.0.0" />
</widget>
