<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Raul Coder - Mobile IDE & AI Engine</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0a0c10">
  
  <!-- FontAwesome & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap">

  <style>
    :root {
      --bg-dark: #0a0c10;
      --bg-panel: #12161f;
      --bg-element: #1b202e;
      --border-color: #2a3142;
      --accent-cyan: #00f0ff;
      --accent-blue: #3a86ff;
      --accent-purple: #8338ec;
      --accent-green: #06d6a0;
      --accent-red: #ff0055;
      --text-main: #f0f4f8;
      --text-muted: #8a99ad;
      --font-code: 'Fira Code', monospace;
      --font-ui: 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body, html { width: 100%; height: 100%; overflow: hidden; background: var(--bg-dark); color: var(--text-main); font-family: var(--font-ui); }

    /* App Layout */
    #app-container { display: flex; flex-direction: column; height: 100vh; width: 100vw; }

    /* Top Navigation Header */
    header {
      height: 48px; background: var(--bg-panel); border-bottom: 1px solid var(--border-color);
      display: flex; align-items: center; justify-content: space-between; padding: 0 12px; gap: 8px; flex-shrink: 0;
    }
    .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.05rem; color: var(--accent-cyan); }
    .brand i { font-size: 1.2rem; }
    
    .nav-actions { display: flex; align-items: center; gap: 6px; }
    .btn {
      background: var(--bg-element); border: 1px solid var(--border-color); color: var(--text-main);
      padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; cursor: pointer;
      display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;
    }
    .btn:active { transform: scale(0.96); }
    .btn-accent { background: var(--accent-blue); border-color: var(--accent-blue); color: #fff; }
    .btn-success { background: var(--accent-green); border-color: var(--accent-green); color: #000; font-weight: 600; }
    
    /* Main Split Body */
    .workspace { display: flex; flex: 1; overflow: hidden; position: relative; }

    /* Sidebar / Drawer */
    .sidebar {
      width: 240px; background: var(--bg-panel); border-right: 1px solid var(--border-color);
      display: flex; flex-direction: column; z-index: 10; transition: transform 0.3s ease;
    }
    .sidebar-header { padding: 12px; border-bottom: 1px solid var(--border-color); font-size: 0.85rem; font-weight: 600; color: var(--text-muted); display: flex; justify-content: space-between; }
    .project-list { flex: 1; overflow-y: auto; padding: 8px; }
    .project-item { padding: 8px 10px; border-radius: 6px; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .project-item.active { background: var(--bg-element); color: var(--accent-cyan); border-left: 3px solid var(--accent-cyan); }

    /* Dual Panes Container */
    .editor-terminal-split { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--bg-dark); }
    
    .pane { flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }
    .pane-header {
      height: 36px; background: var(--bg-panel); border-bottom: 1px solid var(--border-color);
      display: flex; align-items: center; justify-content: space-between; padding: 0 12px; font-size: 0.8rem; font-family: var(--font-code);
    }
    
    /* Code Editor Box */
    textarea#code-editor {
      flex: 1; width: 100%; height: 100%; background: var(--bg-dark); color: #e2e8f0;
      border: none; outline: none; padding: 12px; font-family: var(--font-code); font-size: 0.88rem;
      line-height: 1.5; resize: none; tab-size: 2; white-space: pre; user-select: text;
    }

    /* Coding Keyboard Bar */
    .keyboard-bar {
      height: 40px; background: var(--bg-panel); border-top: 1px solid var(--border-color);
      display: flex; align-items: center; padding: 0 4px; gap: 4px; overflow-x: auto; flex-shrink: 0;
    }
    .key-btn {
      background: var(--bg-element); border: 1px solid var(--border-color); color: var(--accent-cyan);
      min-width: 36px; height: 30px; border-radius: 4px; font-family: var(--font-code); font-size: 0.85rem;
      display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0;
    }
    .key-btn:active { background: var(--accent-cyan); color: #000; }

    /* Terminal Console Box */
    .terminal-box {
      flex: 1; background: #05070a; color: var(--accent-green); font-family: var(--font-code);
      font-size: 0.82rem; padding: 10px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;
    }
    .term-line { line-height: 1.4; word-break: break-all; }
    .term-err { color: var(--accent-red); }
    .term-info { color: var(--accent-cyan); }
    .term-input-line { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
    .term-prompt { color: var(--accent-purple); font-weight: 600; }
    .term-input { flex: 1; background: transparent; border: none; outline: none; color: #fff; font-family: var(--font-code); font-size: 0.82rem; user-select: text; }

    /* AI Chatbot Raul Drawer */
    .ai-drawer {
      width: 320px; background: var(--bg-panel); border-left: 1px solid var(--border-color);
      display: flex; flex-direction: column; z-index: 10;
    }
    .ai-header { padding: 10px 12px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; }
    .ai-title { font-weight: 600; font-size: 0.9rem; color: var(--accent-purple); display: flex; align-items: center; gap: 6px; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
    .msg { padding: 8px 12px; border-radius: 8px; font-size: 0.82rem; line-height: 1.4; max-width: 90%; user-select: text; }
    .msg-raul { background: var(--bg-element); border: 1px solid var(--border-color); align-self: flex-start; color: var(--text-main); }
    .msg-user { background: var(--accent-blue); align-self: flex-end; color: #fff; }
    
    .chat-input-area { padding: 8px; border-top: 1px solid var(--border-color); display: flex; gap: 6px; }
    .chat-input { flex: 1; background: var(--bg-dark); border: 1px solid var(--border-color); color: #fff; padding: 8px; border-radius: 6px; font-size: 0.82rem; outline: none; user-select: text; }

    /* Preview Overlay Modal */
    #preview-modal {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 100;
      flex-direction: column;
    }
    #preview-frame { flex: 1; border: none; background: #fff; }

    /* Responsive Views */
    @media (max-width: 768px) {
      .sidebar { position: absolute; left: 0; top: 0; bottom: 0; transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
      .ai-drawer { position: absolute; right: 0; top: 0; bottom: 0; transform: translateX(100%); transition: transform 0.3s ease; }
      .ai-drawer.open { transform: translateX(0); }
    }
  </style>
</head>
<body>

<div id="app-container">
  <!-- Top Bar -->
  <header>
    <div class="brand">
      <i class="fa-solid fa-code-branch"></i> Raul Coder
    </div>
    <div class="nav-actions">
      <button class="btn" onclick="toggleSidebar()"><i class="fa-solid fa-folder"></i> Projects</button>
      <button class="btn btn-success" onclick="runCodePreview()"><i class="fa-solid fa-play"></i> Play</button>
      <button class="btn btn-accent" onclick="toggleAIDrawer()"><i class="fa-solid fa-robot"></i> Raul AI</button>
    </div>
  </header>

  <div class="workspace">
    <!-- Project Manager Sidebar -->
    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <span>WORKSPACES</span>
        <i class="fa-solid fa-plus" style="cursor:pointer;" onclick="createNewProject()"></i>
      </div>
      <div class="project-list" id="project-list">
        <!-- Projects populated dynamically -->
      </div>
    </div>

    <!-- Central Dual Code & Terminal Split -->
    <div class="editor-terminal-split">
      <!-- Editor Pane -->
      <div class="pane">
        <div class="pane-header">
          <span id="current-filename"><i class="fa-solid fa-file-code"></i> index.html</span>
          <button class="btn" style="padding:2px 8px; font-size:0.75rem;" onclick="saveActiveProject()">Save</button>
        </div>
        <textarea id="code-editor" spellcheck="false" placeholder="// Write code or markdown here..."></textarea>
        
        <!-- Touch Syntax Coding Keyboard -->
        <div class="keyboard-bar">
          <div class="key-btn" onclick="insertCode('  ')">Tab</div>
          <div class="key-btn" onclick="insertCode('<')">&lt;</div>
          <div class="key-btn" onclick="insertCode('>')">&gt;</div>
          <div class="key-btn" onclick="insertCode('/')">/</div>
          <div class="key-btn" onclick="insertCode('&#34;')">"</div>
          <div class="key-btn" onclick="insertCode('{')">{</div>
          <div class="key-btn" onclick="insertCode('}')">}</div>
          <div class="key-btn" onclick="insertCode('(')">(</div>
          <div class="key-btn" onclick="insertCode(')')">)</div>
          <div class="key-btn" onclick="insertCode(';')">;</div>
          <div class="key-btn" onclick="insertCode('=')">=</div>
          <div class="key-btn" onclick="insertCode('!')">!</div>
        </div>
      </div>

      <!-- Terminal Pane -->
      <div class="pane" style="border-top: 1px solid var(--border-color);">
        <div class="pane-header">
          <span><i class="fa-solid fa-terminal"></i> Terminal Console</span>
          <button class="btn" style="padding:2px 8px; font-size:0.75rem;" onclick="clearTerminal()">Clear</button>
        </div>
        <div class="terminal-box" id="terminal">
          <div class="term-line term-info">Raul Coder Virtual Terminal v1.0 [Ready]</div>
          <div class="term-line">Type 'help' or execute live code via Play button.</div>
        </div>
        <div class="term-input-line" style="padding: 4px 8px; background: #05070a;">
          <span class="term-prompt">raul@termux:~$</span>
          <input type="text" class="term-input" id="term-input" onkeydown="handleTerminalCommand(event)" placeholder="Enter command...">
        </div>
      </div>
    </div>

    <!-- AI Raul Assistant Drawer -->
    <div class="ai-drawer" id="ai-drawer">
      <div class="ai-header">
        <div class="ai-title"><i class="fa-solid fa-brain"></i> Raul AI Assistant</div>
        <i class="fa-solid fa-xmark" style="cursor:pointer;" onclick="toggleAIDrawer()"></i>
      </div>
      <div style="padding: 8px; border-bottom: 1px solid var(--border-color);">
        <input type="password" class="chat-input" id="gemini-key" placeholder="Enter Gemini API Key..." onchange="saveAPIKey(this.value)">
      </div>
      <div class="chat-messages" id="chat-messages">
        <div class="msg msg-raul">
          Greetings! I am <b>Raul</b>, your preprogrammed code assistant. I can read, write, refactor, and debug code directly in your active editor.
        </div>
      </div>
      <div class="chat-input-area">
        <input type="text" class="chat-input" id="ai-input" placeholder="Ask Raul to code..." onkeydown="if(event.key==='Enter') sendToRaul()">
        <button class="btn btn-accent" onclick="sendToRaul()"><i class="fa-solid fa-paper-plane"></i></button>
      </div>
    </div>
  </div>
</div>

<!-- Live Preview Modal -->
<div id="preview-modal">
  <div class="pane-header" style="background: #000;">
    <span><i class="fa-solid fa-eye"></i> Active Code Live Preview</span>
    <button class="btn btn-accent" onclick="closePreview()">Close Preview</button>
  </div>
  <iframe id="preview-frame"></iframe>
</div>

<script>
  // App State Storage
  let projects = JSON.parse(localStorage.getItem('raul_projects')) || {
    "default": { name: "Default Project", code: "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { background: #111; color: #00f0ff; font-family: sans-serif; text-align: center; padding-top: 50px; }\n  </style>\n</head>\n<body>\n  <h1>Hello from Raul Coder!</h1>\n  <p>Your local standalone Android environment is running.</p>\n  <script>console.log('App successfully launched!');<\/script>\n</body>\n</html>" }
  };
  let activeProjectId = localStorage.getItem('raul_active_proj') || "default";

  // Elements
  const editor = document.getElementById('code-editor');
  const terminal = document.getElementById('terminal');
  const projectListEl = document.getElementById('project-list');
  const chatMessages = document.getElementById('chat-messages');

  // Initialization
  window.onload = () => {
    loadProjectList();
    loadActiveProject();
    const savedKey = localStorage.getItem('raul_gemini_key');
    if(savedKey) document.getElementById('gemini-key').value = savedKey;
  };

  // UI Toggles
  function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); }
  function toggleAIDrawer() { document.getElementById('ai-drawer').classList.toggle('open'); }

  // Project Management
  function loadProjectList() {
    projectListEl.innerHTML = '';
    Object.keys(projects).forEach(id => {
      const div = document.createElement('div');
      div.className = `project-item ${id === activeProjectId ? 'active' : ''}`;
      div.innerHTML = `<i class="fa-solid fa-code"></i> ${projects[id].name}`;
      div.onclick = () => switchProject(id);
      projectListEl.appendChild(div);
    });
  }

  function switchProject(id) {
    saveActiveProject();
    activeProjectId = id;
    localStorage.setItem('raul_active_proj', id);
    loadActiveProject();
    loadProjectList();
  }

  function loadActiveProject() {
    if(projects[activeProjectId]) {
      editor.value = projects[activeProjectId].code;
    }
  }

  function saveActiveProject() {
    if(projects[activeProjectId]) {
      projects[activeProjectId].code = editor.value;
      localStorage.setItem('raul_projects', JSON.stringify(projects));
      logTerminal('System: Active project saved to storage.', 'term-info');
    }
  }

  function createNewProject() {
    const name = prompt("Enter new project name:");
    if(name) {
      const id = 'proj_' + Date.now();
      projects[id] = { name, code: "<!-- New Project -->\n" };
      switchProject(id);
    }
  }

  // Keyboard Injection
  function insertCode(char) {
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    editor.value = editor.value.substring(0, start) + char + editor.value.substring(end);
    editor.selectionStart = editor.selectionEnd = start + char.length;
    editor.focus();
  }

  // Virtual Terminal Output
  function logTerminal(msg, type = '') {
    const line = document.createElement('div');
    line.className = `term-line ${type}`;
    line.innerText = msg;
    terminal.appendChild(line);
    terminal.scrollTop = terminal.scrollHeight;
  }

  function clearTerminal() { terminal.innerHTML = ''; }

  function handleTerminalCommand(e) {
    if(e.key === 'Enter') {
      const cmd = e.target.value.trim();
      logTerminal(`raul@termux:~$ ${cmd}`);
      e.target.value = '';

      if(cmd === 'help') {
        logTerminal('Available commands: help, clear, run, save, info');
      } else if(cmd === 'clear') {
        clearTerminal();
      } else if(cmd === 'run') {
        runCodePreview();
      } else if(cmd === 'save') {
        saveActiveProject();
      } else {
        logTerminal(`Command not found: ${cmd}`, 'term-err');
      }
    }
  }

  // Live Preview & Console Capture
  function runCodePreview() {
    saveActiveProject();
    const modal = document.getElementById('preview-modal');
    const frame = document.getElementById('preview-frame');
    modal.style.display = 'flex';

    const code = editor.value;
    // Inject console bridge script into frame code
    const consoleBridge = `
      <script>
        const _log = console.log;
        const _err = console.error;
        console.log = function(...args) { parent.postMessage({type:'log', data: args.join(' ')}, '*'); _log(...args); };
        console.error = function(...args) { parent.postMessage({type:'err', data: args.join(' ')}, '*'); _err(...args); };
      <\/script>
    `;
    
    frame.srcdoc = consoleBridge + code;
    logTerminal('Preview Engine: Executing active code...', 'term-info');
  }

  function closePreview() { document.getElementById('preview-modal').style.display = 'none'; }

  // Listen for logs from preview frame
  window.addEventListener('message', (e) => {
    if(e.data && e.data.type === 'log') logTerminal(`[App Log]: ${e.data.data}`);
    if(e.data && e.data.type === 'err') logTerminal(`[App Error]: ${e.data.data}`, 'term-err');
  });

  // Raul AI Integration (Gemini API)
  function saveAPIKey(key) { localStorage.setItem('raul_gemini_key', key); }

  async function sendToRaul() {
    const input = document.getElementById('ai-input');
    const promptText = input.value.trim();
    const apiKey = localStorage.getItem('raul_gemini_key');

    if(!promptText) return;
    if(!apiKey) {
      alert('Please enter your Gemini API Key in the AI panel header.');
      return;
    }

    // Append User Message
    appendMessage(promptText, 'msg-user');
    input.value = '';

    // Append Raul Loading Indicator
    const loadingDiv = appendMessage("Raul is thinking...", 'msg-raul');

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{
            parts: [{
              text: `You are Raul, an expert AI programming assistant built into Raul Coder IDE. The user's current project code is:\n\n\`\`\`\n${editor.value}\n\`\`\`\n\nUser request: ${promptText}\n\nProvide direct, actionable code or answers.`
            }]
          }]
        })
      });

      const data = await response.json();
      const reply = data.candidates[0].content.parts[0].text;
      loadingDiv.innerText = reply;

      // Add "Apply Code" button if answer contains code block
      if(reply.includes('```')) {
        const applyBtn = document.createElement('button');
        applyBtn.className = 'btn btn-accent';
        applyBtn.style.marginTop = '6px';
        applyBtn.innerText = 'Apply Code to Editor';
        applyBtn.onclick = () => {
          const codeMatch = reply.match(/```(?:\w+)?\n([\s\S]*?)```/);
          if(codeMatch && codeMatch[1]) {
            editor.value = codeMatch[1];
            saveActiveProject();
            logTerminal('Raul AI: Applied generated code to editor.', 'term-info');
          }
        };
        loadingDiv.appendChild(applyBtn);
      }
    } catch(err) {
      loadingDiv.innerText = "Error reaching Raul AI engine: " + err.message;
    }
  }

  function appendMessage(text, className) {
    const msg = document.createElement('div');
    msg.className = `msg ${className}`;
    msg.innerText = text;
    chatMessages.appendChild(msg);
    chatMessages.scrollTop = chatMessages.scrollHeight;
    return msg;
  }
</script>
</body>
</html>
